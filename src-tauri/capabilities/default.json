{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may call: the app's commands, and none of Tauri's own, which it does not use",
  "windows": ["main"],
  "permissions": [
    "allow-subscribe",
    "allow-describe-table",
    "allow-fetch-rows",
    "allow-set-selection",
    "allow-set-cells",
    "allow-assign-rows",
    "allow-unassign-rows",
    "allow-set-hover",
    "allow-set-active-classification",
    "allow-select-population",
    "allow-add-population",
    "allow-set-edit-mode",
    "allow-set-role",
    "allow-set-filter",
    "allow-undo",
    "allow-redo",
    "allow-import-table",
    "allow-export-table",
    "allow-region-decimal-mark"
  ]
}
