{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may call: Tauri's defaults and the app's commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-subscribe",
    "allow-describe-table",
    "allow-fetch-rows",
    "allow-set-selection",
    "allow-assign-rows",
    "allow-unassign-rows",
    "allow-set-hover",
    "allow-set-active-classification",
    "allow-select-population",
    "allow-set-role",
    "allow-undo",
    "allow-redo"
  ]
}
