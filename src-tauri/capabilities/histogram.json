{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "histogram",
  "description": "What the windows of the histograms may call: the table, a column of numbers, the selection and their groups panel, and nothing of the individuals' points",
  "windows": ["histogram-*"],
  "permissions": [
    "allow-subscribe",
    "allow-describe-table",
    "allow-describe-widget",
    "allow-fetch-column",
    "allow-region-decimal-mark",
    "allow-set-selection",
    "allow-set-active-classification",
    "allow-select-groups",
    "allow-set-edit-mode"
  ]
}
