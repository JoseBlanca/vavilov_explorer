{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widgets",
  "description": "What the windows of the widgets may call: the app's commands they use, and none of Tauri's own; not adding, editing or deleting a group, which their groups panel does not offer",
  "windows": ["scatter3d-*"],
  "permissions": [
    "allow-subscribe",
    "allow-describe-table",
    "allow-describe-widget",
    "allow-fetch-column",
    "allow-fetch-row",
    "allow-set-hover",
    "allow-set-selection",
    "allow-assign-rows",
    "allow-unassign-rows",
    "allow-region-decimal-mark",
    "allow-set-active-classification",
    "allow-select-groups",
    "allow-set-edit-mode"
  ]
}
